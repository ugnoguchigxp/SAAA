{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "typescript",
    "oxc"
  ],
  "categories": {
    "correctness": "off"
  },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "eslint/no-debugger": "error",
    "eslint/no-unreachable": "error"
  },
  "ignorePatterns": [
    "src/lib/generated/**",
    "**/vendor/**",
    "**/node_modules/**",
    "**/target/**",
    "dist/**",
    "spec/**"
  ]
}

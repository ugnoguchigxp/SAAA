{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocol": {
          "const": "llang-host-v1"
        },
        "requestId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,128}$"
        },
        "packageHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "operation": {
          "const": "inspect"
        }
      },
      "required": [
        "protocol",
        "requestId",
        "packageHash",
        "operation"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocol": {
          "const": "llang-host-v1"
        },
        "requestId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,128}$"
        },
        "packageHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "operation": {
          "const": "verify"
        }
      },
      "required": [
        "protocol",
        "requestId",
        "packageHash",
        "operation"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocol": {
          "const": "llang-host-v1"
        },
        "requestId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,128}$"
        },
        "packageHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "operation": {
          "const": "invoke"
        },
        "input": {
          "type": "object"
        },
        "undefinedFields": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z_$][a-zA-Z0-9_$]*$"
          }
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        }
      },
      "required": [
        "protocol",
        "requestId",
        "packageHash",
        "operation",
        "input",
        "undefinedFields",
        "timeoutMs"
      ]
    }
  ]
}

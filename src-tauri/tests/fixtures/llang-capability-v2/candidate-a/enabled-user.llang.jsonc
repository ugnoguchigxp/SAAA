{
  "language": "l-lang",
  "version": 1,
  "id": "enabled-user",
  "profile": "predicate-i32-v1",
  "description": "有効で停止されていない利用者を判定する。",
  "contract": {
    "version": 1,
    "fields": [
      {
        "name": "enabled",
        "kind": "boolean",
        "values": [],
        "nullable": false,
        "undefinable": false,
        "optional": false,
      },
      {
        "name": "suspended",
        "kind": "boolean",
        "values": [],
        "nullable": false,
        "undefinable": false,
        "optional": false,
      },
    ],
  },
  "body": {
    "kind": "all",
    "conditions": [
      {
        "kind": "equals",
        "property": [
          "enabled"
        ],
        "value": true
      },
      // 停止されている利用者は許可しない。
      {
        "kind": "equals",
        "property": [
          "suspended"
        ],
        "value": false
      },
    ],
  },
}

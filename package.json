{
  "name": "saaa",
  "private": true,
  "version": "0.1.0",
  "description": "Situation-Aware Ambient Agent Runtime",
  "packageManager": "bun@1.3.14",
  "type": "module",
  "scripts": {
    "start": "tauri dev --no-watch",
    "dev": "bun run s11tnext:check && vite",
    "build": "bun run s11tnext:check && bun run ipc:check && tsc && vite build",
    "typecheck": "tsc --noEmit",
    "test:frontend": "bun run s11tnext:check && bun test tests",
    "test:coverage": "bun scripts/test-coverage.ts",
    "test": "bun run test:frontend && cargo test --manifest-path src-tauri/Cargo.toml",
    "size:check": "bun scripts/module-size.ts check",
    "check": "bun run size:check && bun run s11tnext:check && bun run quality:check && bun run ipc:check && bun run typecheck && cargo fmt --check --manifest-path src-tauri/Cargo.toml && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings && bun run test",
    "ipc:generate": "cargo run --manifest-path src-tauri/Cargo.toml --example export_ipc_bindings && cargo run --manifest-path src-tauri/Cargo.toml --example export_voice_asr_bindings",
    "ipc:check": "cargo test --manifest-path src-tauri/Cargo.toml --test ipc_contract_bindings --test voice_asr_contract_bindings",
    "s11tnext:lint": "s11tnext lint --release-profile development",
    "s11tnext:build": "s11tnext build --release-profile development && bun scripts/render-system-contexts.ts",
    "s11tnext:check": "s11tnext build --check --release-profile development && bun scripts/render-system-contexts.ts --check",
    "quality:check": "bun scripts/conversation-quality-eval.ts check && bun run quality:runtime-contract",
    "quality:runtime-contract": "cargo test --manifest-path src-tauri/Cargo.toml --features quality-eval-harness quality_eval::tests",
    "quality:eval": "bun scripts/conversation-quality-eval.ts run",
    "desktop:smoke": "bun scripts/desktop-smoke.ts",
    "mvp2x:preflight": "bun scripts/mvp-2-2.5-readiness.ts preflight",
    "mvp2x:verify": "bun scripts/mvp-2-2.5-readiness.ts verify",
    "mvp2x:report": "bun scripts/mvp-2-2.5-readiness.ts report",
    "larm:preflight": "bun scripts/larm-readiness.ts preflight",
    "larm:canary": "bun scripts/larm-readiness.ts canary",
    "larm:soak": "bun scripts/larm-readiness.ts soak",
    "larm:report": "bun scripts/larm-readiness.ts report",
    "performance:verify": "bun scripts/maximum-performance.ts verify",
    "performance:report": "bun scripts/maximum-performance.ts report",
    "perf:streaming-ui": "bun test tests/streaming-text-buffer.test.ts tests/final-markdown.test.ts tests/streaming-performance.test.ts",
    "perf:meeting-audio": "bun test tests/meeting-audio-worker.test.ts",
    "spec:view": "bunx --bun spec-html ./spec/docs --markdown-lang ja",
    "spec:convert": "bunx --bun spec-html convert",
    "spec:check": "bunx --bun spec-html check ./spec/docs --warnings-as-errors && bunx --bun spec-html check ./spec/docs/.archived --fixer --format",
    "spec:fix": "bunx --bun spec-html check ./spec/docs --fix --warnings-as-errors && bunx --bun spec-html check ./spec/docs/.archived --fixer --format --fix",
    "preview": "vite preview",
    "tauri": "tauri",
    "codex:smoke": "bun scripts/codex-sdk-smoke.ts"
  },
  "dependencies": {
    "@openai/codex-sdk": "0.144.4",
    "@tanstack/react-table": "^9.2.4",
    "@tauri-apps/api": "^2",
    "i18next": "26.3.6",
    "llm-fetch": "0.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "17.0.9",
    "s11tnext": "0.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "jsdom": "26.1.0",
    "s11tnext-cli": "0.1.2",
    "spec-html": "0.1.6",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}

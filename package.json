{
  "name": "saaa",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "description": "Situation-Aware Ambient Agent Runtime",
  "packageManager": "bun@1.4.2",
  "type": "module",
  "scripts": {
    "start": "bun scripts/serial-command.ts -- tauri dev --no-watch",
    "start:adaptive-fixture": "fixture_dir=$(mktemp -d \"${TMPDIR:-/tmp}/saaa-adaptive-fixture.XXXXXX\") && cleanup_fixture() { if [ \"${SAAA_ADAPTIVE_FIXTURE_KEEP_DATA:-}\" = \"1\" ]; then echo \"Keeping adaptive fixture data: $fixture_dir\"; else find \"$fixture_dir\" -depth -delete; fi; } && trap cleanup_fixture EXIT && echo \"Adaptive fixture data: $fixture_dir\" && SAAA_ADAPTIVE_FIXTURE=1 SAAA_SMOKE_MARKER_ID=adaptivefixture SAAA_SMOKE_DATA_DIR=\"$fixture_dir\" SAAA_TOOL_SELECTION_CONFIG=\"$PWD/scripts/adaptive-improvement/mock-tool-selection.json\" bun scripts/serial-command.ts -- tauri dev --no-watch",
    "dev": "bun run s11tnext:check && vite",
    "verify": "bun scripts/verify.ts",
    "verify:advance": "bun scripts/verify.ts advance",
    "verify:full": "bun scripts/verify.ts full",
    "lint": "bun scripts/verify.ts lint",
    "lint:typescript": "bun scripts/verify.ts lint --scope typescript",
    "lint:rust": "bun scripts/verify.ts lint --scope rust",
    "typecheck": "bun scripts/verify.ts typecheck",
    "typecheck:typescript": "bun scripts/verify.ts typecheck --scope typescript",
    "typecheck:rust": "bun scripts/verify.ts typecheck --scope rust",
    "build": "bun scripts/verify.ts build",
    "build:frontend": "bun scripts/verify.ts build --scope typescript",
    "build:rust": "bun scripts/verify.ts build --scope rust",
    "test": "bun scripts/verify.ts test",
    "test:frontend": "bun scripts/verify.ts test --scope typescript",
    "test:frontend:portable": "bun scripts/verify.ts test --scope typescript --portable",
    "test:rust": "bun scripts/verify.ts test --scope rust",
    "test:rust-packages": "bun scripts/verify.ts test --packages-only",
    "format": "bun scripts/verify.ts format --write",
    "format:check": "bun scripts/verify.ts format",
    "format:typescript": "bun scripts/verify.ts format --scope typescript --write",
    "format:rust": "bun scripts/verify.ts format --scope rust --write",
    "format:check:typescript": "bun scripts/verify.ts format --scope typescript",
    "format:check:rust": "bun scripts/verify.ts format --scope rust",
    "test:provider-unit": "bun scripts/verify.ts test --scope typescript -- tests/provider-unit-test-page.test.tsx tests/provider-unit-tts.test.tsx tests/provider-unit-asr.test.tsx",
    "test:asr": "bun scripts/verify.ts asr",
    "e2e:provider-unit": "bun scripts/verify.ts test --package src-tauri -- --features provider-unit-test-harness --test provider_unit_test_e2e",
    "e2e:conversation-queue": "bun scripts/verify.ts conversation-queue",
    "test:coverage": "bun scripts/verify.ts coverage",
    "size:register": "bun scripts/module-size.ts add-missing",
    "size:check": "bun scripts/verify.ts size",
    "unwrap:audit": "bun scripts/unwrap-audit.ts",
    "personal-state:eval": "bun scripts/personal-state-eval.ts",
    "personal-state:performance": "bun scripts/personal-state-performance.ts",
    "check:personal-state": "bun scripts/verify.ts advance --package crates/personal-state-core",
    "check": "bun scripts/verify.ts",
    "clippy:check": "bun scripts/verify.ts lint --package src-tauri",
    "ipc:generate": "bun scripts/serial-command.ts -- cargo run --manifest-path src-tauri/Cargo.toml --example export_ipc_bindings && bun scripts/serial-command.ts -- cargo run --manifest-path src-tauri/Cargo.toml --example export_voice_asr_bindings",
    "ipc:check": "bun scripts/verify.ts ipc",
    "s11tnext:lint": "s11tnext lint --release-profile development",
    "s11tnext:build": "s11tnext build --release-profile development && bun scripts/render-system-contexts.ts",
    "s11tnext:check": "bun scripts/verify.ts generated",
    "quality:check": "bun scripts/verify.ts quality",
    "quality:runtime-contract": "bun scripts/verify.ts test --package src-tauri -- --features quality-eval-harness quality_eval::tests",
    "quality:eval": "bun scripts/conversation-quality-eval.ts run",
    "toolchain:simulate": "bun scripts/serial-command.ts -- cargo run --manifest-path src-tauri/Cargo.toml --bin toolchain_simulate --",
    "desktop:smoke": "bun scripts/desktop-smoke.ts",
    "desktop:e2e": "bun scripts/desktop-e2e.ts",
    "acceptance:core": "bun scripts/verify.ts test --package src-tauri -- --lib acceptance_core_text_turn_persists_and_is_recalled -- --test-threads=1",
    "delegated-work:eval": "bun scripts/delegated-work-eval.ts",
    "delegated-work:performance": "bun scripts/delegated-work-performance.ts",
    "mvp2x:preflight": "bun scripts/mvp-2-2.5-readiness.ts preflight",
    "mvp2x:verify": "bun scripts/mvp-2-2.5-readiness.ts verify",
    "mvp2x:report": "bun scripts/mvp-2-2.5-readiness.ts report",
    "performance:verify": "bun scripts/maximum-performance.ts verify",
    "performance:report": "bun scripts/maximum-performance.ts report",
    "perf:streaming-ui": "bun scripts/verify.ts test --scope typescript -- tests/streaming-text-buffer.test.ts tests/final-markdown.test.ts tests/streaming-performance.test.ts",
    "perf:meeting-audio": "bun scripts/verify.ts test --scope typescript -- tests/meeting-audio-worker.test.ts",
    "spec:view": "bunx --bun spec-html ./spec/docs --markdown-lang ja",
    "spec:convert": "bunx --bun spec-html convert",
    "spec:check": "bunx --bun spec-html check ./spec/docs --warnings-as-errors && bunx --bun spec-html check ./spec/docs/.archived --fixer --format",
    "spec:fix": "bunx --bun spec-html check ./spec/docs --fix --warnings-as-errors && bunx --bun spec-html check ./spec/docs/.archived --fixer --format --fix",
    "preview": "vite preview",
    "tauri": "bun scripts/serial-command.ts -- tauri",
    "codex:smoke": "bun scripts/codex-sdk-smoke.ts",
    "codex:canary": "bun scripts/codex-sdk-canary.ts",
    "coding:canary": "bun scripts/verify.ts test --package src-tauri -- saaa_luna_persists_and_resumes -- --ignored --nocapture",
    "pi:canary": "bun scripts/pi-interface-canary.ts",
    "check:local": "bun scripts/verify.ts",
    "ipc:fixtures": "SAAA_UPDATE_IPC_FIXTURES=1 bun scripts/verify.ts test --package src-tauri -- --lib ipc_receiver_fixture",
    "personal-state:live": "bun scripts/personal-state-live.ts",
    "readiness:verify": "bun scripts/product-readiness.ts",
    "world:eval": "bun scripts/world-eval.ts",
    "build:desktop": "bun scripts/verify.ts desktop-build"
  },
  "dependencies": {
    "@openai/codex-sdk": "0.144.4",
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-table": "^9.2.4",
    "@tanstack/react-virtual": "3.14.12",
    "@tauri-apps/api": "^2",
    "i18next": "26.3.6",
    "llm-fetch": "0.1.0",
    "mermaid": "^12.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "17.0.9",
    "s11tnext": "0.1.2",
    "three": "0.186.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@openuidev/react-lang": "0.2.15",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "jsdom": "26.1.0",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "s11tnext-cli": "0.1.2",
    "spec-html": "0.1.6",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
